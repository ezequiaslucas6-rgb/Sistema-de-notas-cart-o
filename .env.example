# ───────── Banco de dados (PostgreSQL – ex.: Supabase) ─────────
# Conexão com pooler (usada pelo app em produção)
DATABASE_URL="postgresql://notas:notas_dev@localhost:5432/notas?schema=public"
# Conexão direta (usada pelas migrações). Em ambiente local pode ser igual à de cima.
DIRECT_URL="postgresql://notas:notas_dev@localhost:5432/notas?schema=public"

# ───────── Segurança (gere valores únicos: openssl rand -base64 32) ─────────
# Chave de 32 bytes em base64 para criptografar o CPF em repouso (AES-256-GCM)
DATA_ENCRYPTION_KEY=""
# Segredo para o hash pesquisável do CPF (HMAC-SHA256)
CPF_HASH_SECRET=""
# Segredo para assinar tokens de redefinição de senha / API
APP_SECRET=""

# URL pública do sistema (links em e-mails)
APP_URL="http://localhost:3000"

# ───────── Armazenamento dos anexos ─────────
# "local" (pasta ./uploads, só para desenvolvimento) ou "supabase" (produção)
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="notas-anexos"

# ───────── E-mail (Resend). Sem chave, os e-mails são apenas registrados no log ─────────
RESEND_API_KEY=""
EMAIL_FROM="Nortetel Notas <notas@seudominio.com.br>"
# Envia e-mail ao financeiro a cada nova nota (padrão: apenas notificação no sistema)
NOTIFY_EMAIL_ON_NEW="false"

# ───────── Primeiro administrador (usado por: npm run db:seed) ─────────
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_CPF=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ───────── Tarefas agendadas (Vercel Cron envia Authorization: Bearer $CRON_SECRET) ─────────
CRON_SECRET=""
